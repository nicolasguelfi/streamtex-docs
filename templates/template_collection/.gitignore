# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
# No trailing slash: .venv is often a link to ~/.venvs/<project>
.venv
*.egg-info/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Render caches written by builds and `stx validate --build`
.stx_cache/

# Streamlit
.streamlit/secrets.toml

# Claude profile — managed by stx claude install/update, not git
.claude/*
!.claude/custom/
!.claude/.stx-profile
!.claude/stx.lock
