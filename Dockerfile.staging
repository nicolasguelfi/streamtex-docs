FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHERUSAGESTATS=false \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y curl git && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/

# Install base dependencies (without streamtex — installed at startup from branch)
COPY pyproject.toml uv.lock ./
RUN uv sync --no-sources --no-dev && \
    sed -i '/^\[tool\.uv\.sources\]/,/^$/d' pyproject.toml

# Copy all manuals
COPY manuals/ ./manuals/
COPY CHANGELOG.md ./

# Staging banner injection script (patches Streamlit's index.html at startup)
COPY staging-banner.sh ./

# Runtime env vars (set via Coolify API or deploy-staging.sh)
# FOLDER: which manual to serve (default: intro)
# STX_BRANCH: which streamtex library branch to install (default: main)
# STX_DOCS_BRANCH, STX_DOCS_COMMIT: set by deploy-staging.sh for banner display
ENV FOLDER="manuals/stx_manual_intro" \
    STX_BRANCH="main" \
    STX_DOCS_BRANCH="main" \
    STX_DOCS_COMMIT="?"

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health

# At startup: install the specified streamtex branch, collect metadata, inject banner, launch.
# Uses venv binaries directly (no uv run) to avoid any sync/cache interference.
# Exports STX_VERSION, STX_DOCS_BRANCH, STX_DOCS_COMMIT, STX_DEPLOY_TIME for the banner.
ENTRYPOINT ["/bin/sh", "-c", \
            "echo \"Installing streamtex from branch: $STX_BRANCH\" && \
             uv pip install --no-cache --force-reinstall \"git+https://github.com/nicolasguelfi/streamtex@${STX_BRANCH}\" && \
             export STX_VERSION=$(/app/.venv/bin/python -c 'import streamtex; print(streamtex.__version__)') && \
             export STX_LIB_COMMIT=$(/app/.venv/bin/python -c 'from importlib.metadata import distribution; import json; d=distribution(\"streamtex\"); du=d.read_text(\"direct_url.json\"); print(json.loads(du)[\"vcs_info\"][\"commit_id\"][:7])' 2>/dev/null || echo '?') && \
             export STX_DEPLOY_TIME=$(date '+%Y-%m-%d %H:%M') && \
             echo \"streamtex $STX_VERSION | lib: $STX_BRANCH @ $STX_LIB_COMMIT | docs: $STX_DOCS_BRANCH @ $STX_DOCS_COMMIT\" && \
             sh /app/staging-banner.sh && \
             cd /app/${FOLDER} && exec /app/.venv/bin/streamlit run book.py --server.port=8501 --server.address=0.0.0.0"]
