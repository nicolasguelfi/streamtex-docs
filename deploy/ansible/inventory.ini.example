# Ansible Inventory — StreamTeX Deployment
# Copy this file to inventory.ini and fill in your server details.
#
# Usage: ansible-playbook -i deploy/ansible/inventory.ini deploy/ansible/deploy.yml

[streamtex_servers]
# server1 ansible_host=203.0.113.10 ansible_user=deploy
# server2 ansible_host=203.0.113.11 ansible_user=deploy

[streamtex_servers:vars]
ansible_python_interpreter=/usr/bin/python3
docker_compose_version=2.24.0
app_dir=/opt/streamtex
repo_url=https://github.com/nicolasguelfi/streamtex-docs.git
branch=main
